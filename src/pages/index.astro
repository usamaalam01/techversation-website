---
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import Icon from '../components/Icon.astro';
import { courses, certCourses, trainingCourses, listedInstitutes, soon, inst, totals, hm, u, courseUrl, SUBSCRIBE_URL } from '../lib/data';

const t = totals();
const notesCourses = courses.filter((c) => c.notes).length;
const by = (s: string) => courses.find((c) => c.slug === s)!;
const trainings = soon.filter((s) => !s.institute);
const wideFirst = (certCourses.length + 1) % 3 === 0;      // a wide first card only when the grid fills up with it
const picker = listedInstitutes.map((i) => ({ id: i.id, name: i.name, certs: i.certs.map((s) => ({ slug: s, label: `${by(s).short} · ${by(s).name}`, url: courseUrl(by(s)) })), soon: (i.soon ?? []).map((s) => s.toUpperCase()) }));
---
<Base title="Techversation | Free exam prep: video lectures and study notes" description="Free video lectures and study notes for PMP, CSM, AIGP, KCNA, CDMP, TOGAF and AWS (Cloud Practitioner, AI Practitioner, Solutions Architect Associate) exam preparation. Pick your exam, watch the modules, read the notes and plan your weeks." page="home">
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free exam prep · No sign-up</p>
          <h1>Video lectures and study notes for your next exam.</h1>
          <p class="lede">Watch the lecture, read the summary, plan your weeks. Courses for PMP, CSM, AIGP, KCNA, CDMP, TOGAF and AWS, made by the TechVersation channel.</p>

          <form class="finder" id="finder" action={u('search/')} role="search" aria-label="Find your exam">
            <div class="finder-title">Find your exam <i>Institute → Certification</i></div>
            <div class="finder-row">
              <label class="field">Institute<select id="f-inst" aria-label="Institute"><option value="">Choose an institute</option>{listedInstitutes.map((i) => <option value={i.id}>{i.name}</option>)}</select></label>
              <label class="field">Certification<select id="f-cert" aria-label="Certification" disabled><option value="">Pick an institute first</option></select></label>
              <button class="btn btn-primary" id="f-go" type="button">Open course</button>
            </div>
            <div class="finder-or"><span>or search everything</span></div>
            <div class="search-box">
              <Icon name="search" />
              <input id="hero-q" name="q" type="search" placeholder="Courses, modules, terms" aria-label="Search the whole site" />
              <button class="btn btn-ghost" type="submit" style="padding:.7rem 1rem">Search</button>
            </div>
            <div class="chips"><span>Popular:</span>
              <a class="chip" href={u('search/?q=Sprint+Planning')}>Sprint Planning</a>
              <a class="chip" href={u('search/?q=RBAC')}>RBAC</a>
              <a class="chip" href={u('search/?q=earned+value')}>Earned value</a>
              <a class="chip" href={u('search/?q=data+governance')}>Data governance</a>
            </div>
          </form>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="orb"></div><div class="ringline"></div>
          <div class="shot s1"><img src={u(by('pmp').cover)} alt="" width="960" height="540" /></div>
          <div class="shot s2"><img src={u(by('kcna').cover)} alt="" width="960" height="540" /></div>
          <div class="shot s3"><img src={u(by('csm').cover)} alt="" width="960" height="540" /></div>
        </div>
      </div>
    </section>

    <div class="strip"><div class="wrap">
      <span><b>{t.courses}</b> courses</span><span><b>{t.modules}</b> modules</span><span><b>{t.videos}</b> video lectures</span><span><b>{Math.round(t.seconds / 3600)}</b> hours of video</span><span><b>Free</b>, no sign-up</span><span>Study notes for <b>{notesCourses}</b> {notesCourses === 1 ? 'course' : 'courses'}, more on the way</span>
    </div></div>

    <section class="section" id="certs">
      <div class="wrap">
        <div class="section-head">
          <div><p class="eyebrow">Featured courses</p><h2 style="margin-top:.7rem">Start with a full exam-prep course</h2><p>Each course has video lectures with transcripts, slide decks and, where ready, study notes in one standard layout.</p></div>
          <a class="btn btn-ghost" href={u('search/')}>Browse everything</a>
        </div>
        <div class="cards">
          {wideFirst ? <CourseCard course={by('csm')} wide /> : <CourseCard course={by('csm')} />}
          {certCourses.filter((c) => c.slug !== 'csm').map((c) => <CourseCard course={c} />)}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Browse by institute</p><h2 style="margin-top:.7rem">Who sets the exam?</h2></div></div>
        <div class="inst-grid">
          {listedInstitutes.map((i) => {
            const c = i.certs.length ? by(i.certs[0]) : null;
            const label = c ? `${i.certs.length} certification${i.certs.length > 1 ? 's' : ''} · ${c.short}` : `Coming soon · ${soon.filter((s) => s.institute === i.id).map((s) => s.short).join(', ')}`;
            return <a class={`inst ${c ? c.accent : 'c-soon'}`} href={u(`${i.id}/`)}><span class="mono-tile">{i.mono}</span><span><b>{i.name}</b><small>{label}</small></span></a>;
          })}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">How it works</p><h2 style="margin-top:.7rem">Three ways to study, on every course</h2></div></div>
        <div class="ways">
          <div class="way c-csm"><span class="ic"><Icon name="video" size={24} /></span><h3>Watch</h3><p>Short lectures, one module at a time, with a full transcript under each video.</p><ul><li>Slide deck to download</li><li>Practice questions end each lecture</li></ul></div>
          <div class="way c-kcna"><span class="ic"><Icon name="doc" size={24} /></span><h3>Read</h3><p>Exam-focused summaries in one layout: at-a-glance facts, key tables, traps and a quick-reference card.</p><ul><li>Glossary of the key terms</li><li>Each note links to its video</li></ul></div>
          <div class="way c-cdmp"><span class="ic"><Icon name="cal" size={24} /></span><h3>Plan</h3><p>Give your exam date and weekly hours; get a week-by-week schedule that ends with a review week.</p><ul><li>Runs in your browser</li><li>Progress is saved on your device</li></ul></div>
        </div>
      </div>
    </section>

    <section class="section" id="training" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Training courses</p><h2 style="margin-top:.7rem">Skills beyond the exam</h2><p>Courses with no certifying institute, grouped by topic.</p></div></div>
        <div class="cards">
          {trainingCourses.map((c) => <CourseCard course={c} />)}
          {trainings.map((s) => (
            <div class="card soon c-soon"><div class="thumb"><span>Coming soon</span></div><div class="body"><div class="kicker">Training</div><h3>{s.short}</h3><p class="desc">{s.desc}</p></div></div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="request" style="padding-top:0">
      <div class="wrap split">
        <form class="panel ring" id="req">
          <div><p class="eyebrow">Request a course</p><h2 style="margin-top:.7rem;font-size:1.6rem">Which exam should we cover next?</h2></div>
          <div class="form-grid">
            <label class="field">Certification or topic<input class="input" id="r-what" required placeholder="For example, ITIL 4 Foundation" /></label>
            <label class="field">Why do you need it? (optional)<textarea class="input" id="r-why" placeholder="Exam date, your role, what you find hard"></textarea></label>
            <label class="field">Your email, only if you want a reply (optional)<input class="input" id="r-mail" type="email" placeholder="you@example.com" /></label>
          </div>
          <button class="btn btn-primary" type="submit" style="justify-self:start">Send request</button>
          <p class="note" id="r-note">Opens your email app with the request ready to send. Requests are read by the channel owner and decide what gets built next.</p>
        </form>
        <div class="panel" style="align-content:center">
          <p class="eyebrow">New lectures on the channel</p>
          <h2 style="font-size:1.6rem">Get new modules as they publish</h2>
          <p class="muted">Every lecture lives on the TechVersation YouTube channel. Subscribe to see new modules the day they go up.</p>
          <div class="actions"><a class="btn btn-yt btn-lg" href={SUBSCRIBE_URL} target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.3 5 12 5 12 5s-6.3 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.7 19 12 19 12 19s6.3 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3Z"/></svg> Subscribe on YouTube</a></div>
        </div>
      </div>
    </section>
  </main>
  <script type="application/json" id="picker-data" set:html={JSON.stringify(picker)} />
  <script type="application/json" id="resume-data" set:html={JSON.stringify(courses.map((c) => ({ slug: c.slug, mods: c.modules.map((m) => ({ num: m.num, title: m.title, url: u(`${c.institute}/${c.slug}/video/${m.slug}/`) })) })))} />
  <script>import '../scripts/home.ts';</script>
</Base>
