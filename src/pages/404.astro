---
import Base from '../layouts/Base.astro';
import { u } from '../lib/data';
---
<Base title="Page not found" description="The page you asked for is not here. Try the search, or start from the home page to find a course." page="404" noindex>
  <main id="main" class="wrap page-narrow" style="text-align:center;justify-items:center;padding-block:4rem">
    <div class="big404">404</div>
    <h1 style="font-size:clamp(1.6rem,3vw,2.2rem)">This page is not here</h1>
    <p>The link may be old or mistyped. Try the search, or start from the home page.</p>
    <div class="actions"><a class="btn btn-primary" href={u('')}>Go to the home page</a><a class="btn btn-ghost" href={u('search/')}>Search</a></div>
  </main>
</Base>
