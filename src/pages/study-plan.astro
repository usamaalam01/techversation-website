---
import Base from '../layouts/Base.astro';
import { courses } from '../lib/data';

const plan = courses.filter((c) => c.seconds > 0).map((c) => ({
  slug: c.slug, short: c.short, name: c.name, hasNotes: !!c.notes,
  modules: c.modules.map((m) => ({ num: m.num, title: m.title, videoMin: Math.round(m.seconds / 60), notesMin: c.notes?.find((n) => n.num === m.num)?.minutes ?? 0 })),
  notesTotal: (c.notes ?? []).reduce((a, n) => a + n.minutes, 0),
}));
---
<Base title="Study plan" description="Enter your exam date and weekly hours to get a week-by-week study schedule across the video modules and study notes, with a review week at the end." page="plan">
  <main id="main" class="wrap">
    <section style="padding-block:2rem 0.4rem;display:grid;gap:.9rem">
      <p class="eyebrow">Study plan</p>
      <h1 style="font-size:clamp(1.9rem,3.6vw,2.8rem)">Plan the weeks until your exam</h1>
      <p class="muted" style="max-width:62ch;font-size:1.08rem">Tell us your exam date and how many hours you have each week. The plan lists what to study each week and keeps the last week for review. It runs in your browser.</p>
    </section>
    <div class="plan-grid">
      <form class="panel ring plan-form" id="plan-form">
        <label class="field">Course<select id="pc">{plan.map((p) => <option value={p.slug}>{p.short} · {p.name}</option>)}</select></label>
        <label class="field">Exam date<input class="input" id="pd" type="date" /></label>
        <div class="range"><label class="field" for="ph">Hours per week</label><output id="ph-out" for="ph"></output><input id="ph" type="range" min="1" max="20" value="5" /></div>
        <label class="check"><input id="pn" type="checkbox" checked /> Include reading the study notes</label>
        <button class="btn btn-ghost" id="print" type="button">Print or save as PDF</button>
        <p class="note" id="plan-note"></p>
      </form>
      <section aria-live="polite" id="plan-out"></section>
    </div>
  </main>
  <script type="application/json" id="plan-data" set:html={JSON.stringify(plan)} />
  <script>import '../scripts/plan.ts';</script>
</Base>
