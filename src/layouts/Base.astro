---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u } from '../lib/data';

interface Props { title: string; description: string; image?: string; accent?: string; page?: string; noindex?: boolean; type?: string }
const { title, description, image, accent = '', page = '', noindex = false, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(image ?? u('og-default.png'), Astro.site).href;
const full = title.includes('Techversation') ? title : `${title} | Techversation`;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={u('favicon.png')} type="image/png" />
  <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:site_name" content="Techversation" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    // light is the default look; the choice made with the switch is remembered on this device
    try { var q = new URLSearchParams(location.search).get('theme'); var t = q === 'dark' || q === 'light' ? q : localStorage.getItem('tv-theme'); document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light'); } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body class={accent} data-page={page}>
  <a class="skip-link" href="#main">Skip to the content</a>
  <Header page={page} />
  <slot />
  <Footer />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>import '../scripts/common.ts';</script>
</body>
</html>
